# MovEazy — environment template for collaborators
# ---------------------------------------------------------------------------
# 1. Copy this file to `.env` in the repo root (same folder as package.json)
# 2. Fill in values from the team lead (secure share) OR Firebase Console
# 3. For production deploys, also copy to `.env.production` before `npm run deploy:hosting`
# 4. NEVER commit `.env` or `.env.production` — they are gitignored
#
# Repo: https://github.com/jiyanshud22/MOVEASY-WEBSITE
# Firebase project (production): moveasy-30eed
# Live site: https://moveasy-30eed.web.app
# ---------------------------------------------------------------------------

# --- Firebase (required for auth, Firestore, storage) ---
# Firebase Console → Project settings → Your apps → Web app → SDK snippet
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=moveasy-30eed.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=moveasy-30eed
VITE_FIREBASE_STORAGE_BUCKET=moveasy-30eed.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Production custom domain (use in .env.production when deploying to moveazy.in):
# VITE_FIREBASE_AUTH_DOMAIN=moveazy.in

# Admin sign-in: comma-separated emails that get admin role in the app
VITE_ADMIN_EMAILS=your-admin@company.com

# Firestore: for each admin email, create doc bootstrapAdmins/{email} in Firebase Console

# --- Email (optional — welcome / notifications) ---
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_WELCOME_TEMPLATE_ID=
VITE_EMAILJS_ADMIN_NOTIFY_TEMPLATE_ID=
VITE_EMAILJS_INTEREST_TEMPLATE_ID=
VITE_EMAILJS_STATUS_TEMPLATE_ID=
VITE_ADMIN_NOTIFY_EMAIL=

# Cloud Functions (optional)
VITE_CREATE_PROFILE_FUNCTION_URL=
VITE_ONBOARDING_EMAIL_FUNCTION_URL=
VITE_WELCOME_EMAIL_FUNCTION_URL=

# --- Payments — Razorpay hosted pages (rzp.io) ---
# Default in code: https://rzp.io/rzp/fiQh2PZ — override per SKU if needed:
VITE_RAZORPAY_PAYMENT_LINK=
# VITE_RAZORPAY_PAYMENT_LINK_FLAT=        # flat-search ₹1,499
# VITE_RAZORPAY_PAYMENT_LINK_DEPOSIT=     # deposit-saver ₹1,999
# VITE_RAZORPAY_PAYMENT_LINK_MATCH=       # legacy SKU ₹1,999

# Optional: in-page Razorpay modal (needs Cloud Function + server secrets — NOT in this file)
# VITE_RAZORPAY_ORDER_URL=

# Optional: business UPI QR on checkout (Razorpay business VPA only — never personal @ybl)
VITE_BUSINESS_UPI_VPA=
VITE_CHECKOUT_UPI_QR_IMAGE_URL=
VITE_WHATSAPP_ORDER_E164=919413186425
VITE_BILLING_CONTACT_EMAIL=

# --- Observability (optional) ---
VITE_SENTRY_DSN=

# --- App Check (required on localhost if Console enforcement is ON) ---
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
# Local: set true, run npm run dev, copy token from browser console → Firebase Console → App Check → debug tokens
VITE_APPCHECK_DEBUG_TOKEN=true

# --- Dev / QA only ---
# VITE_ENABLE_SEED_LISTINGS=1
# VITE_PLAN_PAGE_ASSET_VERSION=20260512a

# Playwright against production (terminal env, not in .env required):
# set PLAYWRIGHT_BASE_URL=https://moveasy-30eed.web.app/
