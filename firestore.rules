rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function accountRole() {
      return exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role
        : "customer";
    }

    function emailRole() {
      return exists(/databases/$(database)/documents/emailRoles/$(authEmail()))
        ? get(/databases/$(database)/documents/emailRoles/$(authEmail())).data.role
        : "customer";
    }

    function isAdmin() {
      return isSignedIn() && (accountRole() == "admin" || emailRole() == "admin" || isDefaultSeedAdminEmail());
    }

    function isSeller() {
      return isSignedIn() && (accountRole() == "seller" || emailRole() == "seller");
    }

    function isConsultant() {
      return isSignedIn() && (accountRole() == "consultant" || emailRole() == "consultant");
    }

    function isSubAdmin() {
      return isSignedIn() && (accountRole() == "sub_admin" || emailRole() == "sub_admin");
    }

    function ownsListingForPrivate(listingId) {
      return exists(/databases/$(database)/documents/listings/$(listingId))
        && get(/databases/$(database)/documents/listings/$(listingId)).data.sellerEmail == authEmail();
    }

    // Console-only seed list: doc id must equal the user's auth email (lowercase).
    function isBootstrapListedAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/bootstrapAdmins/$(authEmail()));
    }

    // First admin on a new project: app code treats this email as admin (see VITE_ADMIN_EMAILS
    // default in profileService / AuthContext). Firestore must allow the initial userRoles write.
    // Other admin emails: add bootstrapAdmins/{email} in Console (no client read on that path).
    function isDefaultSeedAdminEmail() {
      return authEmail() == "jiyanshudhaka2003@gmail.com";
    }

    function maySelfProvisionInitialAdminRole() {
      return isSignedIn() && (isBootstrapListedAdmin() || isDefaultSeedAdminEmail());
    }

    // Not readable from clients; exists() for rules does not recurse into this match.
    match /bootstrapAdmins/{email} {
      allow read, write: if false;
    }

    // Listings: public read; sellers create/update own rows (incl. withdraw / relist).
    // Hard delete is admin-only (marketplace-style audit trail; matches Housing / NoBroker-style policy).
    match /listings/{listingId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Facebook-scraped rental properties: public read for discovery. Admin-only writes.
    match /facebookProperties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Broker / owner phones — never on public `listings` docs. Staff + listing owner only.
    match /listingPrivate/{listingId} {
      allow read: if isAdmin() || isSubAdmin() || isConsultant()
        || (isSeller() && ownsListingForPrivate(listingId));
      allow create, update: if isAdmin() || isSubAdmin()
        || (isSeller() && ownsListingForPrivate(listingId));
      allow delete: if isAdmin() || isSubAdmin();
    }

    // Canonical role by email. This keeps role privileges stable even before/without uid-bound role docs.
    match /emailRoles/{email} {
      allow read: if isSignedIn() && (isAdmin() || email == authEmail());
      // Users must be able to self-provision their own email role during signup/login,
      // but they must never be able to grant themselves admin.
      allow create: if isSignedIn()
        && email == authEmail()
        && request.resource.data.email == authEmail()
        && request.resource.data.role in ["customer", "seller"];
      allow update: if isAdmin()
        || (isSignedIn()
            && email == authEmail()
            && request.resource.data.email == authEmail()
            && request.resource.data.role in ["customer", "seller"]);
      allow delete: if isAdmin();
    }

    // Roles: admins manage all; users create own customer/seller; bootstrap email can set own admin once.
    match /userRoles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.uid == uid
            && request.resource.data.email == authEmail()
            && request.resource.data.role in ["customer", "seller"])
        || (isSignedIn() && request.auth.uid == uid && maySelfProvisionInitialAdminRole()
            && request.resource.data.uid == uid
            && request.resource.data.email == authEmail()
            && request.resource.data.role == "admin");

      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid && maySelfProvisionInitialAdminRole()
            && request.resource.data.uid == uid
            && request.resource.data.email == authEmail()
            && request.resource.data.role == "admin")
        || (isSignedIn() && request.auth.uid == uid
            && resource.data.role == request.resource.data.role
            && request.resource.data.role in ["customer", "seller"]);

      allow delete: if isAdmin();
    }

    // Profiles: own doc or admin (badge / user management).
    match /userProfiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /assignments/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.customerEmail == authEmail() || resource.data.sellerEmail == authEmail());
      allow write: if isAdmin();
    }

    match /sellerRequests/{id} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /visits/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isAdmin() || resource.data.customerEmail == authEmail() || resource.data.sellerEmail == authEmail());
      allow write: if isAdmin();
    }

    // Seller follow-up notes on their own listing leads (CRM status still admin-only).
    function interestSellerNotesOnlyUpdate() {
      return isSeller()
        && resource.data.sellerEmail == authEmail()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["sellerNotes", "sellerNotesUpdatedAt"])
        && request.resource.data.sellerNotes is string
        && request.resource.data.sellerNotes.size() <= 4000;
    }

    match /interests/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isAdmin() || resource.data.customerEmail == authEmail() || resource.data.sellerEmail == authEmail());
      allow update: if isAdmin() || interestSellerNotesOnlyUpdate();
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isSignedIn()
        && (isAdmin()
          || (isSubAdmin() && resource.data.audience == "admin")
          || resource.data.targetEmail == authEmail());
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (isAdmin()
          || (isSubAdmin() && resource.data.audience == "admin")
          || resource.data.targetEmail == authEmail());
      allow delete: if isAdmin() || (isSubAdmin() && resource.data.audience == "admin");
    }

    match /activityEvents/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // Public marketing copy: contact cards, agents directory, support emails. Admin-only writes.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin() && (docId == "public" || docId == "directoryAgents");
    }

    // Broker profiles — public read for navbar dropdown and agents directory. Admin-only writes.
    // Exception: signed-in users may increment engagementCount (WhatsApp connect tap counter)
    // or update ratingAvg/ratingCount/ratingTotal when submitting a rating.
    match /brokers/{brokerId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["engagementCount"]))
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["ratingAvg", "ratingCount", "ratingTotal"]));
    }

    // Agent WhatsApp — never readable by customers (Connect uses Cloud Function).
    match /agentPrivate/{agentId} {
      allow read, write: if isAdmin() || isSubAdmin();
    }

    // Customer flat-search brief for broker intros.
    match /customerSearchProfiles/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin() || isSubAdmin() || isConsultant();
    }

    // WhatsApp connect analytics — server writes only (no client access).
    match /agentConnectEvents/{id} {
      allow read: if isAdmin() || isSubAdmin();
      allow write: if false;
    }

    // User–broker contact log — written by signed-in users on button click.
    // Users may read their own entries (needed to determine 12-hr rating unlock).
    match /brokerContacts/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || isSubAdmin()
        || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow update, delete: if false;
    }

    // Agent ratings — one doc per (client, agent) pair. Doc id: {clientId}_{agentId}.
    // Public read so average ratings are visible to all; users create/update only their own.
    match /agentRatings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isSignedIn()
        && resource.data.clientId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if isAdmin();
    }

    // Staff CRM — customers/sellers have no access. Admins see all; sub-admins & consultants only rows where they are assignee.
    match /crmLeads/{id} {
      allow read: if isAdmin()
        || (isSubAdmin() && resource.data.assigneeEmail == authEmail())
        || (isConsultant() && resource.data.assigneeEmail == authEmail());
      allow create: if isAdmin() || isSubAdmin();
      allow update: if isAdmin()
        || (isSubAdmin() && resource.data.assigneeEmail == authEmail())
        || (isConsultant() && resource.data.assigneeEmail == authEmail());
      allow delete: if isAdmin()
        || (isSubAdmin() && resource.data.assigneeEmail == authEmail());
    }

    match /crmTasks/{id} {
      allow read: if isAdmin()
        || (isSubAdmin() && resource.data.assigneeEmail == authEmail())
        || (isConsultant() && resource.data.assigneeEmail == authEmail());
      allow create: if isAdmin() || isSubAdmin();
      allow update: if isAdmin()
        || (isSubAdmin() && resource.data.assigneeEmail == authEmail())
        || (isConsultant() && resource.data.assigneeEmail == authEmail());
      allow delete: if isAdmin()
        || (isSubAdmin() && resource.data.assigneeEmail == authEmail());
    }

    match /importJobs/{jobId} {
      allow read, write: if isAdmin() || isSubAdmin();
    }

    // Contact page form submissions — anyone can submit, only admin can read/update status.
    match /contactQueries/{id} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Facebook-scraped rental properties — public read, admin-only writes.
    match /facebookProperties/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
