rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return isSignedIn()
        ? firestore.get(/databases/(default)/documents/userRoles/$(request.auth.uid)).data.role
        : null;
    }

    function isAdminOrSeller() {
      return isSignedIn() && (userRole() == "admin" || userRole() == "seller");
    }

    function isAllowedListingMediaType() {
      return request.resource != null
        && request.resource.contentType != null
        && (
          request.resource.contentType.matches("image/.*")
          || request.resource.contentType.matches("video/.*")
        );
    }

    // Listing images are public for the map
    match /listing-images/{listingId}/{allPaths=**} {
      allow read: if true;

      // Only sellers/admins can write listing media.
      // Restrict to image/video and 100 MB max per file.
      allow create, update: if isAdminOrSeller()
        && isAllowedListingMediaType()
        && request.resource.size < 100 * 1024 * 1024;

      allow delete: if isAdminOrSeller();
    }

    // Generic user uploads (e.g. KYC, documents) - Private
    match /user-documents/{uid}/{allPaths=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
